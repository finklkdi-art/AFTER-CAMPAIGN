# Streamlit Secrets 템플릿 — 이 파일을 복사해 secrets.toml 로 만들고 실제 키를 넣으세요.
#
# 🔴 secrets.toml 은 절대 레포에 커밋하지 마세요 (.gitignore 에 등재됨).
# 🔴 호스팅(Streamlit Community Cloud): 앱 관리 화면의 [Settings > Secrets] 에
#    아래 내용을 그대로 붙여넣으면 됩니다. 파일 업로드가 아니라 플랫폼이 보관합니다.
# 🔴 로컬 실행: 환경변수나 프로젝트 루트 .env 를 써도 됩니다.

# Claude API — 문안 수정·요약·챗봇 품질용
ANTHROPIC_API_KEY = "sk-ant-..."

# (선택) Gemini API — 이미지/일러스트 생성용
GEMINI_API_KEY = "..."
